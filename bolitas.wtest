import bolitas.*
import pacman.*
import wollok.game.*

describe "Tests de bolitas" {

	method initialize() {
		game.clear()
		pacman.pacmanFuerte(false)
		pacman.estaMuerto(false)
		pacman.position(game.at(5,5))
	}

	test "la bolita poderosa activa el estado fuerte y desaparece" {
		const bolita = new BolitaPoderosa(position = game.at(5,5))
		game.addVisual(bolita)

		bolita.chocoConPacman()

		assert.equals(true, pacman.pacmanFuerte())
		assert.equals(false, game.hasVisual(bolita))
		pacman.hacerDebil()
	}

	test "la bolita normal desaparece sin activar el estado fuerte" {
		const bolita = new Bolita(position = game.at(5,5))
		game.addVisual(bolita)

		bolita.chocoConPacman()

		assert.equals(false, pacman.pacmanFuerte())
		assert.equals(false, game.hasVisual(bolita))
	}
}
