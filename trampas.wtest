import nivel.*
import pacman.*
import trampas.*
import bolitas.*
import wollok.game.*

describe "Tests de bombas" {

	method initialize() {
		game.clear()
		game.height(20)
		game.width(20)
		pacman.estaMuerto(false)
		pacman.pacmanFuerte(false)
		pacman.position(game.at(1,1))
		nivel.rojo().position(game.at(5,5))
		nivel.rojo().fantasmaVivo(true)
		game.addVisual(pacman)
		game.addVisual(nivel.rojo())
		nivel.configurarControles()
	}

	test "la bomba colocada elimina al fantasma que la toca" {
		const bomba = new Bomba(position = game.at(5,5))
		game.addVisual(bomba)

		nivel.rojo().moverseHacia(game.at(5,5))

		assert.equals(false, nivel.rojo().fantasmaVivo())
		assert.equals(false, game.hasVisual(nivel.rojo()))
		assert.equals(false, game.hasVisual(bomba))
	}

	test "pacman no elimina la bomba puesta al tocarla" {
		const bomba = new Bomba(position = pacman.position())
		game.addVisual(bomba)

		game.flushEvents(game.currentTime())

		assert.equals(true, game.hasVisual(bomba))
	}

	test "una bolita en la casilla del fantasma no provoca un error" {
		const bolita = new Bolita(position = game.at(5,5))
		game.addVisual(bolita)

		nivel.rojo().moverseHacia(game.at(5,5))

		assert.equals(true, nivel.rojo().fantasmaVivo())
		assert.equals(true, game.hasVisual(bolita))
	}
}
