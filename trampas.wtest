import menu.*
import pacman.*
import trampas.*
import wollok.game.*

describe "Tests de bombas" {

	method initialize() {
		game.clear()
		game.height(20)
		game.width(20)
		pacman.estaMuerto(false)
		pacman.pacmanFuerte(false)
		pacman.position(game.at(1,1))
		menu.rojo().position(game.at(5,5))
		menu.rojo().fantasmaVivo(true)
		game.addVisual(pacman)
		game.addVisual(menu.rojo())
		menu.configurarControles()
	}

	test "la bomba colocada elimina al fantasma que la toca" {
		const bomba = new Bomba(position = game.at(5,5))
		game.addVisual(bomba)

		game.flushEvents(game.currentTime())

		assert.equals(false, menu.rojo().fantasmaVivo())
		assert.equals(false, game.hasVisual(menu.rojo()))
		assert.equals(false, game.hasVisual(bomba))
	}
}
