import pacman.*
import wollok.game.*
import direcciones.*

describe "Tests de pacman" {

	method initialize() {
		game.clear()
		game.height(10) //configurar el tamaño es importante 
		game.width(10)

		pacman.position(game.at(5,5))
	}

	test "pacman mover arriba" {

		pacman.mover(arriba)
		assert.equals(game.at(5,6), pacman.position())
	}

	test "pacman mover abajo" {

		pacman.mover(abajo)
		assert.equals(game.at(5,4), pacman.position())
	}

	test "pacman mover izquierda" {

		pacman.mover(izquierda)
		assert.equals(game.at(4,5), pacman.position())
	}

	test "pacman mover derecha" {

		pacman.mover(derecha)
		assert.equals(game.at(6,5), pacman.position())
	}


	test "pacman no sale de la pantalla por arriba" {
		pacman.position(game.at(5,9))
		assert.throwsException({pacman.mover(arriba)})
		assert.equals(game.at(5,9), pacman.position())
	}

	test "pacman no sale de la pantalla por abajo" {

		pacman.position(game.at(5,0))
		assert.throwsException({pacman.mover(abajo)})
		assert.equals(game.at(5,0), pacman.position())
	}

	test "pacman no sale de la pantalla por izquierda" {

		pacman.position(game.at(0,5))
		assert.throwsException({pacman.mover(izquierda)})
		assert.equals(game.at(0,5), pacman.position())
	}

	test "pacman no sale de la pantalla por derecha" {

		pacman.position(game.at(9,5))
		assert.throwsException({pacman.mover(derecha)})
		assert.equals(game.at(9,5), pacman.position())
	}

}