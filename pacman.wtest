import pacman.*
import wollok.game.*
import direcciones.*
import fantasmas.*
import nivel.*
import trampas.*
import menuGanador.*

describe "Tests de pacman" {

	method initialize() {
		game.clear()
		game.height(10) //configurar el tamaño es importante 
		game.width(10)

		pacman.position(game.at(5,5))
	}

	test "pacman mover arriba" {

		pacman.mover(arriba)
		assert.equals(game.at(5,6), pacman.position())
	}

	test "pacman mover abajo" {

		pacman.mover(abajo)
		assert.equals(game.at(5,4), pacman.position())
	}

	test "pacman mover izquierda" {

		pacman.mover(izquierda)
		assert.equals(game.at(4,5), pacman.position())
	}

	test "pacman mover derecha" {

		pacman.mover(derecha)
		assert.equals(game.at(6,5), pacman.position())
	}

	test "reiniciar deja a pacman en el estado inicial" {
		pacman.sumarPunto()
		pacman.agarrarBomba()
		pacman.pacmanFuerte(true)
		pacman.estaMuerto(true)
		pacman.position(game.at(7,7))

		pacman.reiniciar()

		assert.equals(game.at(1,1), pacman.position())
		assert.equals("=0", pacman.text())
		assert.equals(false, pacman.pacmanFuerte())
		assert.equals(false, pacman.estaMuerto())
	}

	test "poner bomba consume una bomba y la coloca en la posicion de pacman" {
		pacman.position(game.at(5,5))
		pacman.agarrarBomba()

		pacman.ponerBomba()

		assert.equals("=0", pacman.text())
		assert.equals(true, game.getObjectsIn(game.at(5,5)).any({ objeto => objeto.esBomba() }))
	}

	test "reiniciar desde la muerte reconstruye la partida" {
		game.height(20)
		game.width(20)
		pacman.estaMuerto(true)

		nivel.reiniciar()

		assert.equals(false, pacman.estaMuerto())
		assert.equals(true, game.hasVisual(pacman))
		assert.equals(true, game.hasVisual(nivel.rojo()))
	}

	test "los fantasmas aparecen en casillas transitables del mapa" {
		game.height(20)
		game.width(20)
		nivel.reiniciar()
		assert.equals(game.at(10,18), nivel.rojo().position())
		assert.equals(game.at(18,12), nivel.rosa().position())
		assert.equals(game.at(1,10), nivel.naranja().position())
		assert.equals(game.at(9,10), nivel.azul().position())
		assert.equals(false, game.getObjectsIn(nivel.rojo().position()).any({ objeto => objeto.esSolido() }))
		assert.equals(false, game.getObjectsIn(nivel.rosa().position()).any({ objeto => objeto.esSolido() }))
		assert.equals(false, game.getObjectsIn(nivel.naranja().position()).any({ objeto => objeto.esSolido() }))
		assert.equals(false, game.getObjectsIn(nivel.azul().position()).any({ objeto => objeto.esSolido() }))
	}

	test "pacman vuelve a morir por colision despues de reiniciar" {
		game.height(20)
		game.width(20)
		pacman.estaMuerto(true)

		nivel.reiniciar()
		nivel.rojo().position(pacman.position())
		game.flushEvents(game.currentTime())

		assert.equals(true, pacman.estaMuerto())
	}

	test "un fantasma mata a pacman cuando se mueve a su posicion" {
		pacman.estaMuerto(false)
		pacman.pacmanFuerte(false)
		pacman.position(game.at(5,5))
		const fantasma = new FantasmaRojo(
			position = game.at(4,5),
			imagen = "rojo.png",
			fantasmaVivo = true
		)
		game.addVisual(pacman)
		game.addVisual(fantasma)

		fantasma.moverse()

		assert.equals(true, pacman.estaMuerto())
		assert.equals(false, game.hasVisual(pacman))
	}

	test "los fantasmas muestran la imagen asustada cuando pacman esta fuerte" {
		const fantasma = new FantasmaRojo(
			position = game.at(4,5),
			imagen = "rojo.png",
			fantasmaVivo = true
		)

		pacman.pacmanFuerte(true)

		assert.equals("fantasmaAsustado.png", fantasma.image())

		pacman.pacmanFuerte(false)
		assert.equals("rojo.png", fantasma.image())
	}


	test "pacman no sale de la pantalla por arriba" {
		pacman.position(game.at(5,9))
		assert.throwsException({pacman.mover(arriba)})
		assert.equals(game.at(5,9), pacman.position())
	}

	test "pacman no sale de la pantalla por abajo" {

		pacman.position(game.at(5,0))
		assert.throwsException({pacman.mover(abajo)})
		assert.equals(game.at(5,0), pacman.position())
	}

	test "pacman no sale de la pantalla por izquierda" {

		pacman.position(game.at(0,5))
		assert.throwsException({pacman.mover(izquierda)})
		assert.equals(game.at(0,5), pacman.position())
	}

	test "pacman no sale de la pantalla por derecha" {

		pacman.position(game.at(9,5))
		assert.throwsException({pacman.mover(derecha)})
		assert.equals(game.at(9,5), pacman.position())
	}

	test "pacman gana al recoger las 80 bolitas del mapa" {
		pacman.reiniciar()
		(1..79).forEach({ _ => pacman.sumarPunto() })

		assert.equals(false, game.hasVisual(menuGanador))
		pacman.sumarPunto()
		assert.equals(true, game.hasVisual(menuGanador))
	}

	test "volver al menu de inicio despues de ganar" {
		game.height(20)
		game.width(20)
		nivel.reiniciar()
		(1..80).forEach({ _ => pacman.sumarPunto() })

		nivel.volverAlMenuInicio()

		assert.equals(false, game.hasVisual(menuGanador))
		assert.equals(false, game.hasVisual(pacman))
		assert.equals(false, nivel.juegoIniciado())
		assert.equals("menuInicio.png", nivel.fondoDeJuego())

		nivel.iniciar()
		assert.equals(false, game.hasVisual(menuGanador))
	}

}