import muro.*
import trampas.*
import wollok.game.*
import pacman.*
import direcciones.*
import bombasRandom.*
import spawners.*
import menu.*
import fantasmas.*
import sonidos.*

program juego {



  

  game.title("PACMAN INVADERS")
  
  game.boardGround(menu.fondoDeJuego())
  game.height(20)
	game.width(20)

//CONTROLES MENU
  keyboard.num1().onPressDo({menu.iniciar()
                            sonidos.sonidoInicio()})
  
                keyboard.r().onPressDo({if (pacman.estaMuerto()) {menu.reiniciar()}})
                keyboard.left().onPressDo({ pacman.mover(izquierda) })
                keyboard.right().onPressDo({ pacman.mover(derecha) })
                keyboard.up().onPressDo({ pacman.mover(arriba) })
                keyboard.down().onPressDo({ pacman.mover(abajo) })
                game.onCollideDo(pacman, { elemento => elemento.chocoConPacman() })

// game.onCollideDo(menu.rojo, {elemento => elemento.chocoCon(menu.rojo)})

game.start()
}  